# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Secret! Server only (Vercel env). Never put it in the browser or client code.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Students log in with phone + PIN; internally this placeholder email domain is used
NEXT_PUBLIC_STUDENT_EMAIL_DOMAIN=students.ambition.app
NEXT_PUBLIC_LIBRARY_NAME=Ambition Library

# Only for `npm run migrate` (Supabase → Connect → Direct connection). Secret!
DATABASE_URL=postgresql://postgres:YOUR-DB-PASSWORD@db.xxxxxxxx.supabase.co:5432/postgres
